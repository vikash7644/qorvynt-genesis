# QORVYNT: Genesis — first character animation authoring manifest
# Executable QORVYNT data using the currently supported map literal syntax.
# Genesis reads this source profile to configure the live GLB character importer.
# The browser reader supports the define/map/array authoring subset, not QVM bytecode.

define humanoid_rig := map("root", "Hips", "spine", "Spine", "head", "Head", "left_arm", "LeftUpperArm", "right_arm", "RightUpperArm", "left_forearm", "LeftForearm", "right_forearm", "RightForearm", "left_leg", "LeftUpperLeg", "right_leg", "RightUpperLeg", "left_shin", "LeftLowerLeg", "right_shin", "RightLowerLeg", "left_foot", "LeftFoot", "right_foot", "RightFoot")

define idle_clip := map("name", "idle", "loop", 1, "duration_ms", 1800, "root_bob", 2, "spine_sway", 3, "arm_swing", 2, "leg_swing", 1)
define walk_clip := map("name", "walk", "loop", 1, "duration_ms", 720, "root_bob", 5, "spine_sway", 4, "arm_swing", 24, "leg_swing", 28)
define run_clip := map("name", "run", "loop", 1, "duration_ms", 460, "root_bob", 9, "spine_sway", 7, "arm_swing", 42, "leg_swing", 48)
define jump_clip := map("name", "jump", "loop", 0, "duration_ms", 680, "root_bob", 32, "spine_sway", 8, "arm_swing", 36, "leg_swing", 22)
define attack_clip := map("name", "pulse_attack", "loop", 0, "duration_ms", 520, "root_bob", 4, "spine_sway", 18, "arm_swing", 58, "leg_swing", 12)

define explorer_character := map("id", "genesis_explorer", "rig_version", 1, "coordinate_system", "right_handed_y_up", "skeleton_type", "hierarchical_bone_rig", "rig", humanoid_rig, "idle", idle_clip, "walk", walk_clip, "run", run_clip, "jump", jump_clip, "attack", attack_clip)

show explorer_character

define explorer_asset_pipeline := map("format", "glb", "specification", "gltf_2_0", "requires_skinned_mesh", true, "target_height", 3, "idle_clip", "idle", "walk_clip", "walk", "run_clip", "run", "jump_clip", "jump", "attack_clip", "attack", "required_bones", map("bone_0", "Hips", "bone_1", "Spine", "bone_2", "Head", "bone_3", "LeftUpperArm", "bone_4", "RightUpperArm", "bone_5", "LeftUpperLeg", "bone_6", "RightUpperLeg"), "clip_aliases", map("idle", map("primary", "idle", "alternate_1", "stand", "alternate_2", "breathing"), "walk", map("primary", "walk", "alternate_1", "walking", "alternate_2", "locomotion_walk"), "run", map("primary", "run", "alternate_1", "running", "alternate_2", "sprint"), "jump", map("primary", "jump", "alternate_1", "jump_start", "alternate_2", "leap"), "attack", map("primary", "attack", "alternate_1", "pulse_attack", "alternate_2", "melee", "alternate_3", "strike")))

show explorer_asset_pipeline
